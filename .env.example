# PostgreSQL - configurações do container docker-compose.yml
POSTGRES_USER=gupy
POSTGRES_PASSWORD=gupy
POSTGRES_DB=gupy_scraper
POSTGRES_PORT=5434

# String de conexão usada pela aplicação (Fase 3)
DATABASE_URL=postgresql://gupy:gupy@localhost:5434/gupy_scraper

# LLM (Fase 4) - chave de API do provedor de IA (OpenAI/Anthropic/Gemini etc.)
LLM_API_KEY=preenchido no arquivo .env (não comitado no repositório)